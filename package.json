{
  "name": "intersite",
  "version": "1.0.0-rc.9",
  "private": true,
  "type": "module",
  "description": "One testing library for every project: slop lint, traffic capture, replay, and gates.",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "intersite": "./bin/intersite.mjs"
  },
  "exports": {
    "./capture": "./capture/index.mjs",
    "./lint": "./lint/plugin.mjs",
    "./track": "./track/index.mjs",
    "./shared/*": "./shared/*.mjs",
    "./intersite.schema.json": "./intersite.schema.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "node bin/intersite.mjs lint",
    "check": "node bin/intersite.mjs check"
  },
  "peerDependencies": {
    "@oxlint/plugins": ">=1.93.0",
    "oxlint": ">=1.93.0",
    "oxlint-tsgolint": ">=7.0.0",
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@oxlint/plugins": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "^1.65.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "files": [
    "bin",
    "cli",
    "capture",
    "collector",
    "gates",
    "lint",
    "replay",
    "shared",
    "skills",
    "templates",
    "track",
    "intersite.schema.json",
    "CONTRACT.md"
  ]
}

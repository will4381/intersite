{
  "name": "intersite",
  "version": "1.0.0-rc.25",
  "private": true,
  "type": "module",
  "description": "One testing library for every project: slop lint, traffic capture, replay, and gates.",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "intersite": "./bin/intersite.mjs"
  },
  "exports": {
    "./capture": "./capture/index.mjs",
    "./lint": "./lint/plugin.mjs",
    "./track": "./track/index.mjs",
    "./shared/*": "./shared/*.mjs",
    "./intersite.schema.json": "./intersite.schema.json"
  },
  "scripts": {
    "test": "npm run test:rust && npm run test:js",
    "test:js": "GITHUB_ACTIONS= INTERSITE_OFFLINE=1 node --test ${TEST_SHARD:+--test-shard=$TEST_SHARD} \"test/**/*.test.mjs\"",
    "test:rust": "cargo test --release --quiet --manifest-path core/Cargo.toml",
    "lint": "node bin/intersite.mjs lint",
    "check": "node bin/intersite.mjs check",
    "typecheck": "tsc -p tsconfig.json",
    "build:core": "cargo build --release --manifest-path core/Cargo.toml"
  },
  "peerDependencies": {
    "@oxlint/plugins": ">=1.93.0",
    "oxlint": ">=1.93.0",
    "oxlint-tsgolint": ">=7.0.0",
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@oxlint/plugins": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@types/node": "^22.20.5",
    "oxc-parser": "0.157.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "files": [
    "bin",
    "core/Cargo.toml",
    "core/Cargo.lock",
    "core/src",
    "cli",
    "capture",
    "collector",
    "gates",
    "lint",
    "replay",
    "shared",
    "skills",
    "templates",
    "track",
    "intersite.schema.json",
    "CONTRACT.md"
  ]
}
